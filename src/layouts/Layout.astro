---
import '../styles/global.css';

interface Props {
	title?: string;
	noindex?: boolean;
}

const { title = 'Pukánszky Péter — Software Engineer', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<title>{title}</title>
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pukánszky Péter" />
		<meta property="og:title" content="Pukánszky Péter — Software Engineer" />
		<meta
			property="og:description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<meta property="og:url" content={Astro.site} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Pukánszky Péter — Software Engineer" />
		<meta
			name="twitter:description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
		/>

		<script is:inline>
			try {
				const stored = localStorage.getItem('theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.setAttribute('data-theme', theme);
			} catch (e) {
				/* localStorage unavailable; CSS follows the OS setting, dark when there is none */
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
