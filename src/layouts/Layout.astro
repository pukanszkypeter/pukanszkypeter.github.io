---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<title>Pukánszky Péter — Software Engineer</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pukánszky Péter" />
		<meta property="og:title" content="Pukánszky Péter — Software Engineer" />
		<meta
			property="og:description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<meta property="og:url" content={Astro.site} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Pukánszky Péter — Software Engineer" />
		<meta
			name="twitter:description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
		<script is:inline>
			const stored = localStorage.getItem('theme');
			if (stored === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-bg text-ink">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
