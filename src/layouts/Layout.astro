---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Portfolio of Pukánszky Péter, software engineer — projects, skills, and experience."
		/>
		<title>Pukánszky Péter — Software Engineer</title>
		<script is:inline>
			const stored = localStorage.getItem('theme');
			if (stored === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-bg text-ink">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
