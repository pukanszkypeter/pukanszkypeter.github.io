---
type Tier = 'core' | 'familiar';

const groups: { key: string; label: string; skills: { name: string; tier: Tier }[] }[] = [
	{
		key: 'aiTools',
		label: 'AI Tools',
		skills: [
			{ name: 'Claude Code', tier: 'familiar' },
			{ name: 'GitHub Copilot', tier: 'core' },
		],
	},
	{
		key: 'languages',
		label: 'Languages',
		skills: [
			{ name: 'Java', tier: 'core' },
			{ name: 'TypeScript', tier: 'core' },
			{ name: 'Python', tier: 'familiar' },
		],
	},
	{
		key: 'frameworks',
		label: 'Frameworks & Libraries',
		skills: [
			{ name: 'Spring Boot', tier: 'core' },
			{ name: 'React', tier: 'core' },
			{ name: 'Angular', tier: 'familiar' },
		],
	},
	{
		key: 'architecture',
		label: 'Architecture & APIs',
		skills: [
			{ name: 'Microservices', tier: 'core' },
			{ name: 'API Design', tier: 'core' },
		],
	},
	{
		key: 'databases',
		label: 'Databases',
		skills: [
			{ name: 'MySQL', tier: 'core' },
			{ name: 'MongoDB', tier: 'core' },
		],
	},
	{
		key: 'devops',
		label: 'DevOps & Infrastructure',
		skills: [
			{ name: 'Docker', tier: 'core' },
			{ name: 'Kubernetes', tier: 'core' },
			{ name: 'GitHub', tier: 'core' },
			{ name: 'Kafka', tier: 'core' },
			{ name: 'Keycloak', tier: 'core' },
			{ name: 'Linux', tier: 'familiar' },
			{ name: 'Prometheus', tier: 'familiar' },
			{ name: 'Grafana', tier: 'familiar' },
		],
	},
	{
		key: 'testing',
		label: 'Testing',
		skills: [
			{ name: 'JUnit', tier: 'familiar' },
			{ name: 'Jest', tier: 'familiar' },
			{ name: 'Playwright', tier: 'familiar' },
			{ name: 'Vitest', tier: 'familiar' },
		],
	},
];

const certifications = [
	{
		name: 'Reinvention with Agentic AI — Accenture',
		url: 'https://www.credly.com/badges/dbed460e-7bc6-4107-adbe-a80f66206657/public_url',
	},
];

const coreBadge =
	'rounded-full bg-accent-subtle px-2.5 py-1 text-xs text-accent transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm';
const familiarBadge =
	'rounded-full border border-border px-2.5 py-1 text-xs text-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-sm';
---

<section id="skills" class="scroll-mt-16 bg-surface px-4 py-20">
	<div class="mx-auto w-full min-w-0 max-w-3xl">
		<h2 class="text-2xl font-semibold text-ink" data-i18n="skills.heading">Skills</h2>

		<div class="mt-3 flex items-center gap-4 text-xs text-muted">
			<span class="flex items-center gap-1.5">
				<span class="h-2 w-2 rounded-full bg-accent-subtle border border-accent/40" />
				<span data-i18n="skills.core">Core</span>
			</span>
			<span class="flex items-center gap-1.5">
				<span class="h-2 w-2 rounded-full border border-border" />
				<span data-i18n="skills.familiar">Familiar with</span>
			</span>
		</div>

		<div class="mt-6 space-y-4">
			{
				groups.map((group) => (
					<div>
						<h3 class="text-sm font-medium text-muted" data-i18n={`skills.groups.${group.key}`}>{group.label}</h3>
						<div class="mt-2 flex flex-wrap gap-1.5">
							{[...group.skills]
								.sort((a, b) => (a.tier === b.tier ? 0 : a.tier === 'core' ? -1 : 1))
								.map((skill) => (
									<span class={skill.tier === 'core' ? coreBadge : familiarBadge}>{skill.name}</span>
								))}
						</div>
					</div>
				))
			}

			<div>
				<h3 class="text-sm font-medium text-muted" data-i18n="skills.certifications">Certifications</h3>
				<div class="mt-2 flex flex-wrap gap-1.5">
					{
						certifications.map((cert) => (
							<a
								href={cert.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent-subtle px-3 py-1.5 text-xs font-medium text-accent transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-sm"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 flex-shrink-0">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
								</svg>
								{cert.name}
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 flex-shrink-0">
									<path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M10 14L21 3" />
								</svg>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
