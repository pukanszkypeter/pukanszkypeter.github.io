---
type Tier = 'core' | 'familiar';

const groups: { key: string; label: string; skills: { name: string; tier: Tier }[] }[] = [
	{
		key: 'aiTools',
		label: 'AI Tools',
		skills: [
			{ name: 'GitHub Copilot', tier: 'core' },
			{ name: 'Claude Code', tier: 'familiar' },
		],
	},
	{
		key: 'languages',
		label: 'Languages',
		skills: [
			{ name: 'Java', tier: 'core' },
			{ name: 'TypeScript', tier: 'core' },
			{ name: 'Python', tier: 'familiar' },
		],
	},
	{
		key: 'frameworks',
		label: 'Frameworks & Libraries',
		skills: [
			{ name: 'Spring Boot', tier: 'core' },
			{ name: 'React', tier: 'core' },
			{ name: 'Angular', tier: 'familiar' },
		],
	},
	{
		key: 'architecture',
		label: 'Architecture & APIs',
		skills: [
			{ name: 'Microservices', tier: 'core' },
			{ name: 'API Design', tier: 'core' },
		],
	},
	{
		key: 'databases',
		label: 'Databases',
		skills: [
			{ name: 'MySQL', tier: 'core' },
			{ name: 'MongoDB', tier: 'core' },
		],
	},
	{
		key: 'devops',
		label: 'DevOps & Infrastructure',
		skills: [
			{ name: 'Docker', tier: 'core' },
			{ name: 'Kubernetes', tier: 'core' },
			{ name: 'GitHub', tier: 'core' },
			{ name: 'Kafka', tier: 'core' },
			{ name: 'Keycloak', tier: 'core' },
			{ name: 'Linux', tier: 'familiar' },
			{ name: 'Prometheus', tier: 'familiar' },
			{ name: 'Grafana', tier: 'familiar' },
		],
	},
	{
		key: 'testing',
		label: 'Testing',
		skills: [
			{ name: 'JUnit', tier: 'familiar' },
			{ name: 'Jest', tier: 'familiar' },
			{ name: 'Playwright', tier: 'familiar' },
			{ name: 'Vitest', tier: 'familiar' },
		],
	},
];

const certificationUrl = 'https://www.credly.com/badges/dbed460e-7bc6-4107-adbe-a80f66206657/public_url';
---

<section id="skills" class="sec" style="max-width:1160px;margin:0 auto;padding:128px 24px 0">
	<div class="reveal" style="display:flex;flex-direction:column;gap:14px;margin-bottom:44px">
		<span class="mono" style="font-size:13px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase" data-i18n="skills.label">03 — Skills</span>
		<h2 class="display" style="font-size:clamp(34px,4.8vw,58px);line-height:1.04;font-weight:700;max-width:760px" data-i18n="skills.headline">The toolbox, from code to production.</h2>
		<div style="display:inline-flex;flex-wrap:wrap;gap:8px;align-self:flex-start;margin-top:8px">
			<span class="chip chip-core" data-i18n="skills.core">Core</span>
			<span class="chip chip-fam" data-i18n="skills.familiar">Familiar with</span>
		</div>
	</div>
	<div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:20px">
		{
			groups.map((group) => (
				<div class="glass calm" style="border-radius:28px;padding:30px;display:flex;flex-direction:column;gap:18px;min-width:0">
					<h3 class="display" style="font-size:21px;font-weight:700" data-i18n={`skills.groups.${group.key}`}>{group.label}</h3>
					<div style="display:flex;flex-wrap:wrap;gap:8px">
						{[...group.skills]
							.sort((a, b) => (a.tier === b.tier ? 0 : a.tier === 'core' ? -1 : 1))
							.map((skill) => (
								<span class={skill.tier === 'core' ? 'chip chip-core' : 'chip chip-fam'}>{skill.name}</span>
							))}
					</div>
				</div>
			))
		}
		<a href={certificationUrl} target="_blank" rel="noopener noreferrer" class="glass lift" style="border-radius:28px;padding:30px;display:flex;flex-direction:column;justify-content:space-between;gap:22px;min-width:0;background:var(--tint)">
			<span class="mono" style="font-size:12px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase" data-i18n="skills.certLabel">Certification</span>
			<div style="display:flex;flex-direction:column;gap:8px">
				<h3 class="display" style="font-size:24px;line-height:1.15;font-weight:700" data-i18n="skills.certName">Reinvention with Agentic AI</h3>
				<p style="font-size:15px;color:var(--ink2)" data-i18n="skills.certIssuer">Issued by Accenture</p>
			</div>
			<span style="display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;color:var(--atext)">
				<span data-i18n="skills.viewBadge">View badge</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
			</span>
		</a>
	</div>
</section>
