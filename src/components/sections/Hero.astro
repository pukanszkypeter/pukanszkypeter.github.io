---
import { Image } from 'astro:assets';
import profile from '../../assets/profile.jpg';
---

<section id="home" class="sec hero-sec" style="max-width:1160px;margin:0 auto;box-sizing:border-box;display:flex;align-items:center">
	<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:48px;align-items:center;width:100%">
		<div style="display:flex;flex-direction:column;gap:28px;align-items:flex-start">
			<div class="glass rise" style="display:inline-flex;align-items:center;gap:10px;padding:8px 16px 8px 12px;border-radius:999px;font-size:14px;font-weight:500">
				<span class="pulse" style="width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block"></span>
				<span data-i18n="hero.badge">Open to new opportunities</span>
			</div>
			<h1 class="display rise hero-title" style="line-height:0.98;font-weight:700;animation-delay:.1s">
				Pukánszky<br />Péter<br /><span class="grad" data-i18n="hero.tagline">Software Engineer</span>
			</h1>
			<p class="rise" style="font-size:clamp(17px,1.5vw,20px);line-height:1.6;color:var(--ink2);max-width:520px;animation-delay:.2s" data-i18n="hero.blurb">
				Software engineer at Accenture, using AI tooling to accelerate full-cycle delivery.
			</p>
			<div class="rise" style="display:flex;flex-wrap:wrap;gap:14px;animation-delay:.3s">
				<a class="btn btn-primary" href="#projects">
					<span data-i18n="hero.viewProjects">View Projects</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
				</a>
				<a class="btn btn-glass glass" href="#contact"><span data-i18n="hero.contactMe">Contact Me</span></a>
			</div>
		</div>
		<div class="rise" style="position:relative;width:min(420px,100%);aspect-ratio:1/1;margin:0 auto;animation-delay:.25s">
			<div class="spin" style="position:absolute;inset:6%;border-radius:50%;background:conic-gradient(from 0deg,#FF8A3D,#FFE2C8,#C2410C,#FFB067,#FF8A3D);filter:blur(1px)"></div>
			<div style="position:absolute;inset:9.5%;border-radius:50%;overflow:hidden;box-shadow:var(--gshadow2)">
				<Image
					src={profile}
					alt="Pukánszky Péter"
					width={340}
					height={510}
					densities={[1, 2, 3]}
					quality={90}
					style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block"
				/>
			</div>
			<div class="glass float heropill pfull" style="position:absolute;top:24%;left:-9%;padding:10px 16px;border-radius:16px;font-size:14px;font-weight:600;white-space:nowrap;animation-delay:-3s" data-i18n="hero.pillFullStack">Full-stack</div>
			<div class="glass float heropill" style="position:absolute;top:3%;right:5%;padding:10px 16px;border-radius:16px;font-size:14px;font-weight:600;white-space:nowrap;animation-delay:-5.5s" data-i18n="hero.pillAiAssisted">AI-assisted</div>
			<div class="glass float heropill" style="position:absolute;bottom:9%;left:7%;padding:10px 16px;border-radius:16px;font-size:14px;font-weight:600;white-space:nowrap;animation-delay:-1s" data-i18n="hero.pillYears">5+ years</div>
			<div class="glass float heropill pdel" style="position:absolute;bottom:16%;right:-13%;padding:10px 16px;border-radius:16px;font-size:14px;font-weight:600;white-space:nowrap;animation-delay:-4s" data-i18n="hero.pillOwnership">Delivery ownership</div>
		</div>
	</div>
</section>

<style>
	.hero-sec {
		width: 100%;
		padding: 72px 24px 56px;
		flex: 1 1 auto;
	}
	.hero-title {
		font-size: clamp(46px, 7.4vw, 98px);
	}
	@media (min-width: 900px) {
		.hero-sec {
			padding-top: 44px;
			padding-bottom: 28px;
		}
		.hero-title {
			font-size: clamp(42px, 6.2vw, 82px);
		}
	}
</style>
