---
import { Image } from 'astro:assets';
import profile from '../../assets/profile.jpg';
---

<section id="home" class="scroll-mt-16 snap-start flex min-h-[calc(100vh-4rem)] items-center bg-bg px-4">
	<div class="mx-auto w-full min-w-0 max-w-3xl text-center">
		<div class="relative z-0 mx-auto w-fit">
			<div
				class="absolute left-1/2 top-1/2 -z-10 h-48 w-48 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/25 blur-2xl dark:bg-accent/25 dark:blur-3xl"
				aria-hidden="true"
			>
			</div>
			<Image
				src={profile}
				alt="Pukánszky Péter"
				width={320}
				height={480}
				quality={90}
				class="mx-auto h-40 w-40 rounded-full border border-border object-cover object-[center_15%] transition-transform duration-300 hover:scale-110"
			/>
		</div>

		<h1 class="mt-6 text-4xl font-bold text-ink sm:text-5xl">Pukánszky Péter</h1>
		<p class="mt-3 text-lg text-accent" data-i18n="hero.tagline">Software Engineer</p>
		<p class="mx-auto mt-6 max-w-xl text-muted" data-i18n="hero.blurb">
			Software engineer at Accenture Hungary, using AI tooling to accelerate full-cycle delivery
			— from cross-team technical decisions to translating business needs into working software.
		</p>

		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<a
				href="#projects"
				class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
				data-i18n="hero.viewProjects"
			>
				View Projects
			</a>
			<a
				href="#contact"
				class="rounded-md border border-border px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
				data-i18n="hero.contactMe"
			>
				Contact Me
			</a>
		</div>
	</div>
</section>
