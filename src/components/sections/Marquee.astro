---
const stack = [
	'Java',
	'TypeScript',
	'Python',
	'Spring Boot',
	'React',
	'Angular',
	'Microservices',
	'API Design',
	'Kafka',
	'Docker',
	'Kubernetes',
	'MySQL',
	'MongoDB',
	'Claude Code',
	'GitHub Copilot',
	'Playwright',
	'Grafana',
];
const marquee = [...stack, ...stack];
---

<div
	aria-hidden="true"
	class="glass marq-wrap"
	style="border-left:0;border-right:0;border-radius:0;overflow:hidden;padding:18px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)"
>
	<div class="marq">
		{
			marquee.map((item) => (
				<span class="mono" style="font-size:14px;font-weight:500;color:var(--ink2);white-space:nowrap;padding:0 8px">
					{item}
					<span style="color:var(--accent);margin-left:22px">✦</span>
				</span>
			))
		}
	</div>
</div>

<style>
	/* Pause so a name can be read: hover with a mouse, or keep a finger on the strip */
	@media (hover: hover) {
		.marq-wrap:hover .marq {
			animation-play-state: paused;
		}
	}
	.marq-wrap.is-held .marq {
		animation-play-state: paused;
	}
	.marq-wrap {
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}
</style>

<script>
	const strip = document.querySelector<HTMLElement>('.marq-wrap');
	strip?.addEventListener('pointerdown', (event) => {
		if (event.pointerType !== 'mouse') strip.classList.add('is-held');
	});
	// A vertical page scroll that starts on the strip fires pointercancel, so the strip resumes.
	for (const type of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
		strip?.addEventListener(type, () => strip.classList.remove('is-held'));
	}
	// A long press would otherwise open the browser's menu and end the hold.
	strip?.addEventListener('contextmenu', (event) => {
		if (strip.classList.contains('is-held')) event.preventDefault();
	});
</script>
