	{
		title: '[Project Name]',
		description: '[One to two sentences describing what the project does and why you built it.]',
		details:
			'[Longer placeholder text for the dialog — project goals, your role, challenges solved, and outcomes. Replace with real details once available.]',
		tags: ['[Tech 1]', '[Tech 2]', '[Tech 3]'],
		url: '#',
	},
	{
		title: '[Project Name]',
		description: '[One to two sentences describing what the project does and why you built it.]',
		details:
			'[Longer placeholder text for the dialog — project goals, your role, challenges solved, and outcomes. Replace with real details once available.]',
		tags: ['[Tech 1]', '[Tech 2]', '[Tech 3]'],
		url: '#',
	},
	{
		title: '[Project Name]',
		description: '[One to two sentences describing what the project does and why you built it.]',
		details:
			'[Longer placeholder text for the dialog — project goals, your role, challenges solved, and outcomes. Replace with real details once available.]',
		tags: ['[Tech 1]', '[Tech 2]', '[Tech 3]'],
		url: '#',
	},
	{
		title: '[Project Name]',
		description: '[One to two sentences describing what the project does and why you built it.]',
		details:
			'[Longer placeholder text for the dialog — project goals, your role, challenges solved, and outcomes. Replace with real details once available.]',
		tags: ['[Tech 1]', '[Tech 2]', '[Tech 3]'],
		url: '#',
	},
];
---

<section
	id="projects"
	class="scroll-mt-16 bg-bg px-4 py-20"
>
	<div class="mx-auto w-full min-w-0 max-w-3xl">
		<div class="flex flex-wrap items-baseline gap-3">
			<h2 class="text-2xl font-semibold text-ink" data-i18n="projects.heading">Projects</h2>
			<span class="rounded-full bg-accent-subtle px-3 py-1 text-xs font-medium text-accent" data-i18n="projects.badge">
				Work in progress
			</span>
		</div>

		<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				projects.map((project) => (
					<button
						type="button"
						class="project-trigger project-card group flex flex-col rounded-lg border border-border bg-surface p-6 text-left transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-md"
						data-title={project.title}
						data-description={project.description}
						data-details={project.details}
						data-tags={JSON.stringify(project.tags)}
						data-url={project.url}
					>
						<h3 class="font-semibold text-ink" data-i18n="projects.item.title">{project.title}</h3>
						<p class="mt-2 flex-1 text-sm text-muted" data-i18n="projects.item.description">{project.description}</p>

						<div class="mt-4 flex flex-wrap gap-2">
							{project.tags.map((tag, i) => (
								<span class="rounded-full bg-accent-subtle px-2.5 py-1 text-xs text-accent" data-i18n={`projects.item.tags.${i}`}>
									{tag}
								</span>
							))}
						</div>

						<span class="mt-4 text-sm font-medium text-accent transition-colors group-hover:text-accent-hover">
							<span data-i18n="projects.viewDetails">View Details</span> &rarr;
						</span>
					</button>
				))
			}
		</div>
	</div>

	<dialog
		id="project-dialog"
		class="fixed top-1/2 left-1/2 m-0 h-[80vh] w-full max-w-2xl -translate-x-1/2 -translate-y-1/2 rounded-lg border border-border bg-bg p-0 text-ink"
	>
		<div class="flex h-full flex-col">
			<div class="flex items-center justify-between border-b border-border px-6 py-4">
				<h3 id="dialog-title" class="text-lg font-semibold text-ink" />
				<button
					type="button"
					id="dialog-close"
					aria-label="Close"
					class="flex h-8 w-8 items-center justify-center rounded text-muted transition-colors hover:text-accent"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						class="h-5 w-5"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
			</div>

			<div class="flex-1 overflow-y-auto px-6 py-6">
				<div class="flex h-32 items-center justify-center rounded-lg border border-dashed border-border bg-surface text-sm text-muted">
					Image placeholder
				</div>

				<p id="dialog-description" class="mt-6 text-sm text-muted" />
				<p id="dialog-details" class="mt-4 text-sm text-muted" />

				<div id="dialog-tags" class="mt-6 flex flex-wrap gap-2" />
			</div>

			<div class="flex items-center justify-end gap-3 border-t border-border px-6 py-4">
				<a
					id="dialog-open"
					href="#"
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
					data-i18n="projects.openProject"
				>
					Open Project
				</a>
				<button
					type="button"
					id="dialog-close-footer"
					class="rounded-md border border-border px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
					data-i18n="projects.close"
				>
					Close
				</button>
			</div>
		</div>
	</dialog>
</section>

<style>
	#project-dialog::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}
</style>

<script>
	const dialog = document.getElementById('project-dialog') as HTMLDialogElement | null;
	const dialogTitle = document.getElementById('dialog-title');
	const dialogDescription = document.getElementById('dialog-description');
	const dialogDetails = document.getElementById('dialog-details');
	const dialogTags = document.getElementById('dialog-tags');
	const dialogClose = document.getElementById('dialog-close');
	const dialogCloseFooter = document.getElementById('dialog-close-footer');
	const dialogOpen = document.getElementById('dialog-open') as HTMLAnchorElement | null;

	document.querySelectorAll<HTMLButtonElement>('.project-trigger').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (!dialog) return;

			if (dialogTitle) dialogTitle.textContent = trigger.dataset.title ?? '';
			if (dialogDescription) dialogDescription.textContent = trigger.dataset.description ?? '';
			if (dialogDetails) dialogDetails.textContent = trigger.dataset.details ?? '';

			if (dialogTags) {
				dialogTags.innerHTML = '';
				const tags: string[] = JSON.parse(trigger.dataset.tags ?? '[]');
				tags.forEach((tag) => {
					const span = document.createElement('span');
					span.className = 'rounded-full bg-accent-subtle px-2.5 py-1 text-xs text-accent';
					span.textContent = tag;
					dialogTags.appendChild(span);
				});
			}

			if (dialogOpen) dialogOpen.href = trigger.dataset.url ?? '#';

			dialog.showModal();
		});
	});

	dialogClose?.addEventListener('click', () => dialog?.close());
	dialogCloseFooter?.addEventListener('click', () => dialog?.close());

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>
