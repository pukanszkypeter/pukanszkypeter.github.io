---
const projects = [
	{ slug: 'project-one', liveUrl: '#', sourceUrl: '#' },
	{ slug: 'project-two', liveUrl: '#', sourceUrl: '#' },
	{ slug: 'project-three', liveUrl: '#', sourceUrl: '#' },
];

const placeholder = {
	name: '[Project Name]',
	year: '[Year]',
	desc: '[A short description of the project and your role in it.]',
	overview: '[A short overview of the project: the problem it solves, who it is for, and what the end result looks like.]',
	role: '[Your responsibilities and what you owned.]',
	highlights: ['[Key outcome or feature]', '[Key outcome or feature]', '[Key outcome or feature]'],
	tags: ['[Tech]', '[Tech]', '[Tech]', '[Tech]'],
};
---

<section id="projects" class="sec" style="max-width:1160px;margin:0 auto;padding:128px 24px 0">
	<div class="reveal" style="display:flex;flex-direction:column;gap:14px;margin-bottom:44px">
		<span class="mono" style="font-size:13px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase" data-i18n="projects.label">02 — Projects</span>
		<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px">
			<h2 class="display" style="font-size:clamp(34px,4.8vw,58px);line-height:1.04;font-weight:700" data-i18n="projects.headline">Selected work</h2>
			<span class="glass mono" style="padding:8px 14px;border-radius:999px;font-size:12px;font-weight:500" data-i18n="projects.badge">Work in progress</span>
		</div>
	</div>
	<div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:20px">
		{
			projects.map((project, i) => (
				<div
					class="glass lift project-card"
					style="position:relative;border-radius:28px;padding:14px;display:flex;flex-direction:column;gap:20px;min-width:0"
					data-index={i}
					data-slug={project.slug}
					data-live-url={project.liveUrl}
					data-source-url={project.sourceUrl}
					data-name={placeholder.name}
					data-year={placeholder.year}
					data-desc={placeholder.desc}
					data-overview={placeholder.overview}
					data-role={placeholder.role}
					data-highlights={JSON.stringify(placeholder.highlights)}
					data-tags={JSON.stringify(placeholder.tags)}
				>
					<div style="position:relative;height:190px;border-radius:18px;overflow:hidden;background:var(--ph)">
						<div style="position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,0.55) 1.2px,transparent 1.8px);background-size:18px 18px" />
						<span class="mono" style="position:absolute;left:16px;top:14px;font-size:13px;font-weight:500;color:var(--atext)">{String(i + 1).padStart(2, '0')}</span>
						<span class="mono" style="position:absolute;right:16px;bottom:14px;font-size:12px;color:var(--atext)" data-i18n="projects.imagePlaceholder">[ project image ]</span>
					</div>
					<div style="display:flex;flex-direction:column;gap:12px;padding:0 14px 14px">
						<h3 class="display" style="font-size:24px;font-weight:700">
							<button type="button" class="project-trigger" data-i18n={`projects.items.${i}.name`} style="position:static;background:none;border:0;padding:0;font:inherit;color:inherit;text-align:left;cursor:pointer">
								{placeholder.name}
							</button>
						</h3>
						<p style="font-size:15px;line-height:1.6;color:var(--ink2)" data-i18n={`projects.items.${i}.desc`}>{placeholder.desc}</p>
						<div style="display:flex;flex-wrap:wrap;gap:8px">
							{placeholder.tags.slice(0, 3).map((tag, t) => (
								<span class="chip" style="padding:5px 11px;font-size:12px" data-i18n={`projects.items.${i}.tags.${t}`}>{tag}</span>
							))}
						</div>
						<span style="display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;color:var(--atext)">
							<span data-i18n="projects.viewDetails">View Details</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
						</span>
					</div>
				</div>
			))
		}
	</div>
</section>

<dialog id="project-dialog" class="dlg-root" aria-labelledby="dlg-title">
	<div class="glass-strong dlg">
		<span class="dlg-grab" aria-hidden="true"></span>
		<div class="dlg-drag" aria-hidden="true"></div>
		<div class="dlg-close">
			<button type="button" id="dlg-close-btn" class="dlg-x" aria-label="Close project details">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
		</div>

		<div class="dlg-scroll">
		<div class="dlg-media" style="padding:20px 0 20px 20px;display:flex;flex-direction:column;gap:12px;min-width:0">
			<div style="position:relative;flex:1 1 auto;min-height:260px;border-radius:24px;overflow:hidden;background:var(--ph)">
				<div style="position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,0.55) 1.2px,transparent 1.8px);background-size:18px 18px" />
				<span class="mono" id="dlg-number" style="position:absolute;left:18px;top:16px;font-size:13px;font-weight:500;color:var(--atext)">01</span>
				<span class="mono" style="position:absolute;right:18px;bottom:16px;font-size:12px;color:var(--atext)" data-i18n="projects.imagePlaceholder">[ project image ]</span>
			</div>
			<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
				<span class="thumb on" aria-hidden="true"></span>
				<span class="thumb" aria-hidden="true"></span>
				<span class="thumb" aria-hidden="true"></span>
			</div>
		</div>

		<div class="dlg-body" style="padding:44px 40px 28px 36px;display:flex;flex-direction:column;gap:22px;min-width:0">
			<div style="display:flex;flex-direction:column;gap:10px;padding-right:44px">
				<span class="mono" id="dlg-label" style="font-size:13px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase">Project 01 — [Year]</span>
				<h2 id="dlg-title" class="display" style="font-size:clamp(30px,3.4vw,42px);line-height:1.06;font-weight:700">[Project Name]</h2>
			</div>
			<p id="dlg-overview" style="font-size:16px;line-height:1.65;color:var(--ink2)" />

			<div style="display:flex;flex-direction:column;gap:10px">
				<span class="mono" style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--atext)" data-i18n="projects.dialog.role">My role</span>
				<p id="dlg-role" style="font-size:15px;line-height:1.6;color:var(--ink2)" />
			</div>

			<div style="display:flex;flex-direction:column;gap:12px">
				<span class="mono" style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--atext)" data-i18n="projects.dialog.highlights">Highlights</span>
				<div id="dlg-highlights" style="display:flex;flex-direction:column;gap:8px" />
			</div>

			<div id="dlg-tags" style="display:flex;flex-wrap:wrap;gap:8px" />

			<div style="display:flex;flex-wrap:wrap;gap:12px">
				<a id="dlg-live" class="btn btn-primary" href="#" target="_blank" rel="noopener noreferrer">
					<span data-i18n="projects.dialog.liveDemo">Live demo</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
				</a>
				<a id="dlg-source" class="btn btn-glass glass" href="#" target="_blank" rel="noopener noreferrer">
					<span data-i18n="projects.dialog.sourceCode">Source code</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
				</a>
			</div>

			<div style="margin-top:auto;padding-top:14px;border-top:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between;gap:8px">
				<button type="button" id="dlg-prev" class="pn" aria-label="Previous project">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
					<span data-i18n="projects.dialog.previous">Previous</span>
				</button>
				<span class="mono" id="dlg-counter" style="font-size:12px;color:var(--muted)">01 / 03</span>
				<button type="button" id="dlg-next" class="pn" aria-label="Next project">
					<span data-i18n="projects.dialog.next">Next</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
				</button>
			</div>
		</div>
		</div>
	</div>
</dialog>

<style>
	.project-trigger::after {
		content: '';
		position: absolute;
		inset: 0;
	}
</style>

<script>
	const dialog = document.getElementById('project-dialog') as HTMLDialogElement | null;
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
	const closeBtn = document.getElementById('dlg-close-btn');
	const prevBtn = document.getElementById('dlg-prev');
	const nextBtn = document.getElementById('dlg-next');

	const dlgNumber = document.getElementById('dlg-number');
	const dlgLabel = document.getElementById('dlg-label');
	const dlgTitle = document.getElementById('dlg-title');
	const dlgOverview = document.getElementById('dlg-overview');
	const dlgRole = document.getElementById('dlg-role');
	const dlgHighlights = document.getElementById('dlg-highlights');
	const dlgTags = document.getElementById('dlg-tags');
	const dlgCounter = document.getElementById('dlg-counter');
	const dlgLive = document.getElementById('dlg-live') as HTMLAnchorElement | null;
	const dlgSource = document.getElementById('dlg-source') as HTMLAnchorElement | null;

	let currentIndex = -1;
	let lastTrigger: HTMLElement | null = null;

	const sheet = dialog?.querySelector<HTMLElement>('.dlg') ?? null;
	const dragZone = dialog?.querySelector<HTMLElement>('.dlg-drag') ?? null;
	const sheetQuery = window.matchMedia('(max-width: 760px)');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const SHEET_SETTLE_MS = 220;
	const SHEET_CLOSE_DISTANCE = 100;
	const SHEET_FLICK_VELOCITY = 0.5; // px per ms

	let drag: { pointerId: number; startY: number; lastY: number; lastTime: number; velocity: number; offset: number } | null = null;
	let settleTimer: ReturnType<typeof setTimeout> | undefined;

	const resetSheet = () => {
		clearTimeout(settleTimer);
		settleTimer = undefined;
		drag = null;
		dialog?.classList.remove('dlg-settling');
		dialog?.style.removeProperty('--dlg-backdrop-opacity');
		if (sheet) {
			sheet.style.transform = '';
			sheet.style.transition = '';
		}
	};

	const moveSheet = (offset: number) => {
		if (!sheet || !dialog) return;
		sheet.style.transform = `translateY(${offset}px)`;
		const fade = Math.min(1, Math.max(0, offset) / sheet.offsetHeight);
		dialog.style.setProperty('--dlg-backdrop-opacity', String(1 - fade));
	};

	const readCard = (card: HTMLElement) => ({
		slug: card.dataset.slug ?? '',
		liveUrl: card.dataset.liveUrl ?? '#',
		sourceUrl: card.dataset.sourceUrl ?? '#',
		name: card.dataset.name ?? '',
		year: card.dataset.year ?? '',
		desc: card.dataset.desc ?? '',
		overview: card.dataset.overview ?? '',
		role: card.dataset.role ?? '',
		highlights: JSON.parse(card.dataset.highlights ?? '[]') as string[],
		tags: JSON.parse(card.dataset.tags ?? '[]') as string[],
	});

	const renderProject = (index: number) => {
		const card = cards[index];
		if (!card || !dialog) return;
		const data = readCard(card);
		const num = String(index + 1).padStart(2, '0');
		const total = String(cards.length).padStart(2, '0');

		if (dlgNumber) dlgNumber.textContent = num;
		if (dlgLabel) dlgLabel.textContent = `Project ${num} — ${data.year}`;
		if (dlgTitle) dlgTitle.textContent = data.name;
		if (dlgOverview) dlgOverview.textContent = data.overview;
		if (dlgRole) dlgRole.textContent = data.role;
		if (dlgCounter) dlgCounter.textContent = `${num} / ${total}`;
		if (dlgLive) dlgLive.href = data.liveUrl;
		if (dlgSource) dlgSource.href = data.sourceUrl;

		if (dlgHighlights) {
			dlgHighlights.innerHTML = '';
			data.highlights.forEach((h) => {
				const row = document.createElement('div');
				row.className = 'hl';
				const dot = document.createElement('i');
				const span = document.createElement('span');
				span.textContent = h;
				row.append(dot, span);
				dlgHighlights.appendChild(row);
			});
		}

		if (dlgTags) {
			dlgTags.innerHTML = '';
			data.tags.forEach((tag) => {
				const span = document.createElement('span');
				span.className = 'chip';
				span.style.padding = '5px 11px';
				span.style.fontSize = '12px';
				span.textContent = tag;
				dlgTags.appendChild(span);
			});
		}

		currentIndex = index;
	};

	const openDialog = (index: number, trigger: HTMLElement | null, pushHistory: boolean) => {
		if (!dialog || !cards[index]) return;
		lastTrigger = trigger;
		resetSheet();
		renderProject(index);
		if (!dialog.open) {
			dialog.showModal();
			dialog.querySelector('.dlg-scroll')?.scrollTo(0, 0);
		}
		document.body.style.overflow = 'hidden';

		const slug = cards[index].dataset.slug;
		if (slug && pushHistory) {
			history.pushState({ project: slug }, '', `${location.pathname}#${slug}`);
		}
	};

	const closeDialog = (adjustHistory = true) => {
		resetSheet();
		if (!dialog?.open) return;
		dialog.close();
		document.body.style.overflow = '';

		if (adjustHistory && location.hash && cards.some((c) => `#${c.dataset.slug}` === location.hash)) {
			history.back();
		}

		lastTrigger?.focus();
		lastTrigger = null;
	};

	cards.forEach((card, index) => {
		const trigger = card.querySelector<HTMLButtonElement>('.project-trigger');
		trigger?.addEventListener('click', () => openDialog(index, trigger, true));
	});

	closeBtn?.addEventListener('click', () => closeDialog());
	dialog?.addEventListener('cancel', (event) => {
		event.preventDefault();
		closeDialog();
	});
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) closeDialog();
	});

	// Swipe down on the bottom sheet's handle strip to close it.
	const settleSheet = (close: boolean) => {
		if (!sheet || !dialog) return;
		drag = null;
		if (reducedMotion.matches) {
			if (close) closeDialog();
			else resetSheet();
			return;
		}
		dialog.classList.add('dlg-settling');
		sheet.style.transition = `transform ${SHEET_SETTLE_MS}ms cubic-bezier(0.2, 0.8, 0.2, 1)`;
		sheet.style.transform = close ? 'translateY(100%)' : 'translateY(0)';
		dialog.style.setProperty('--dlg-backdrop-opacity', close ? '0' : '1');
		settleTimer = setTimeout(() => {
			if (close) closeDialog();
			else resetSheet();
		}, SHEET_SETTLE_MS);
	};

	dragZone?.addEventListener('pointerdown', (event) => {
		if (!sheet || !sheetQuery.matches || settleTimer !== undefined) return;
		if (event.pointerType === 'mouse' && event.button !== 0) return;
		drag = { pointerId: event.pointerId, startY: event.clientY, lastY: event.clientY, lastTime: event.timeStamp, velocity: 0, offset: 0 };
		dragZone.setPointerCapture(event.pointerId);
		sheet.style.transition = 'none';
	});

	dragZone?.addEventListener('pointermove', (event) => {
		if (!drag || event.pointerId !== drag.pointerId) return;
		const delta = event.clientY - drag.startY;
		// Downward follows the finger; upward only rubber-bands a few pixels.
		drag.offset = delta >= 0 ? delta : Math.max(-8, delta * 0.2);
		const elapsed = event.timeStamp - drag.lastTime;
		if (elapsed > 0) drag.velocity = (event.clientY - drag.lastY) / elapsed;
		drag.lastY = event.clientY;
		drag.lastTime = event.timeStamp;
		moveSheet(drag.offset);
	});

	dragZone?.addEventListener('pointerup', (event) => {
		if (!drag || event.pointerId !== drag.pointerId) return;
		const { offset, velocity, lastTime } = drag;
		// A finger that paused before lifting is not a flick.
		const flick = event.timeStamp - lastTime < 80 && velocity > SHEET_FLICK_VELOCITY && offset > 10;
		settleSheet(offset > SHEET_CLOSE_DISTANCE || flick);
	});

	dragZone?.addEventListener('pointercancel', (event) => {
		if (!drag || event.pointerId !== drag.pointerId) return;
		settleSheet(false);
	});

	prevBtn?.addEventListener('click', () => {
		const next = (currentIndex - 1 + cards.length) % cards.length;
		renderProject(next);
		const slug = cards[next].dataset.slug;
		if (slug) history.replaceState({ project: slug }, '', `${location.pathname}#${slug}`);
	});
	nextBtn?.addEventListener('click', () => {
		const next = (currentIndex + 1) % cards.length;
		renderProject(next);
		const slug = cards[next].dataset.slug;
		if (slug) history.replaceState({ project: slug }, '', `${location.pathname}#${slug}`);
	});

	window.addEventListener('popstate', () => {
		const slug = location.hash.slice(1);
		const index = cards.findIndex((c) => c.dataset.slug === slug);
		if (index >= 0) {
			openDialog(index, null, false);
		} else {
			closeDialog(false);
		}
	});

	// Shareable link: open directly if the page loads with a matching hash.
	const initialSlug = location.hash.slice(1);
	const initialIndex = cards.findIndex((c) => c.dataset.slug === initialSlug);
	if (initialIndex >= 0) {
		openDialog(initialIndex, null, false);
	}
</script>
