---
const entries = [
  {
    role: "Software Engineer",
    org: "Accenture",
    location: "Budapest, Hungary",
    dates: "September 2022 – Present",
    description:
      "Full-cycle, full-stack development of a greenfield internal order-processing tool, supporting the deprecation of a legacy database. Coordinate with other engineering teams, present technical decisions directly to business stakeholders, and use AI tooling to accelerate delivery.",
  },
  {
    role: "Software Developer",
    org: "Citi",
    location: "Budapest, Hungary",
    dates: "June 2022 – September 2022",
    description: "Java maintenance of financial software during a three-month engagement.",
  },
  {
    role: "Software Developer",
    org: "Systemathx",
    location: "Budapest, Hungary",
    dates: "March 2021 – June 2022",
    description:
      "Implemented several features for an in-factory decision-support application — including production-line quality assurance and factory data visualization — over 15 months of intensive full-stack development, supporting daily logistics operations.",
  },
];
---

<section
  id="experience"
  class="scroll-mt-16 bg-bg px-4 py-20"
>
  <div class="mx-auto w-full min-w-0 max-w-3xl">
    <h2 class="text-2xl font-semibold text-ink" data-i18n="experience.heading">Experience</h2>

    <div class="mt-8 space-y-4">
      {
        entries.map((entry, i) => (
          <div class="rounded-md border-l-2 border-accent/30 py-3 pl-6 pr-6 transition-all duration-300 hover:border-accent hover:bg-accent-subtle/50 hover:pl-7">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-ink">
                <span data-i18n={`experience.entries.${i}.role`}>{entry.role}</span>{" "}
                <span class="font-normal text-muted">· {entry.org}</span>
              </h3>
              <span class="text-sm text-muted" data-i18n={`experience.entries.${i}.dates`}>{entry.dates}</span>
            </div>
            <p class="text-sm text-muted" data-i18n={`experience.entries.${i}.location`}>{entry.location}</p>
            <p class="mt-2 text-sm text-muted" data-i18n={`experience.entries.${i}.description`}>{entry.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
