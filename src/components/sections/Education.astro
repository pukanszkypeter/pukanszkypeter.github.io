---
const entries = [
	{
		degree: "Master's in Computer Science",
		dates: 'September 2021 – June 2023',
		thesis:
			'Thesis on researching various mobile robot dispersion algorithms, presenting the results and simulations through a web application.',
	},
	{
		degree: "Bachelor's in Computer Science",
		dates: 'September 2018 – June 2021',
		thesis:
			'Thesis on developing a web application to compare and present sentiment analysis results from Python and SAP.',
	},
];
---

<section id="education" class="sec" style="max-width:1160px;margin:0 auto;padding:128px 24px 0">
	<div class="reveal" style="display:flex;flex-direction:column;gap:14px;margin-bottom:44px">
		<span class="mono" style="font-size:13px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase" data-i18n="education.label">05 — Education</span>
		<h2 class="display" style="font-size:clamp(34px,4.8vw,58px);line-height:1.04;font-weight:700" data-i18n="education.headline">Eötvös Loránd University.</h2>
	</div>
	<div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:20px">
		{
			entries.map((entry, i) => (
				<div class="glass calm" style="border-radius:28px;padding:32px;display:flex;flex-direction:column;gap:14px;min-width:0">
					<span class="mono" style="font-size:13px;color:var(--muted)" data-i18n={`education.entries.${i}.dates`}>{entry.dates}</span>
					<h3 class="display" style="font-size:25px;line-height:1.15;font-weight:700" data-i18n={`education.entries.${i}.degree`}>{entry.degree}</h3>
					<p style="font-size:15px;line-height:1.65;color:var(--ink2)" data-i18n={`education.entries.${i}.thesis`}>{entry.thesis}</p>
				</div>
			))
		}
	</div>
</section>
