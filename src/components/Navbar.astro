---
import ThemeToggle from './ThemeToggle.astro';
import LangMenu from './LangMenu.astro';

const links = [
	{ href: '#home', label: 'Home', key: 'home' },
	{ href: '#about', label: 'About', key: 'about' },
	{ href: '#projects', label: 'Projects', key: 'projects' },
	{ href: '#skills', label: 'Skills', key: 'skills' },
	{ href: '#experience', label: 'Experience', key: 'experience' },
	{ href: '#education', label: 'Education', key: 'education' },
	{ href: '#contact', label: 'Contact', key: 'contact' },
];

const languages = [
	{ code: 'en', label: 'English' },
	{ code: 'hu', label: 'Magyar' },
	{ code: 'de', label: 'Deutsch' },
];
---

<header style="position:sticky;top:0;z-index:50;padding:0 16px;display:flow-root">
	<nav
		aria-label="Main"
		class="glass-strong"
		style="max-width:1160px;margin:14px auto 0;border-radius:999px;padding:6px 8px;display:flex;align-items:center;gap:12px"
	>
		<a href="#home" class="navname display" aria-label="Pukánszky Péter — home">
			<span class="nn-full">Pukánszky Péter<span style="color:var(--accent)">.</span></span>
			<span class="nn-short">PP<span style="color:var(--accent)">.</span></span>
		</a>
		<div
			class="navlinks"
			style="flex:1 1 auto;display:flex;align-items:center;justify-content:center;gap:2px;overflow-x:auto;min-width:0;scrollbar-width:none"
		>
			{
				links.map((link) => (
					<a class="navlink" href={link.href}>
						<span data-i18n={`nav.${link.key}`}>{link.label}</span>
					</a>
				))
			}
		</div>
		<div class="navright">
			<ThemeToggle id="theme-toggle" ariaLabel="Toggle theme" />
			<LangMenu />
		</div>
		<details class="menu">
			<summary aria-label="Menu">
				<svg class="ic-bars" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg class="ic-x" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</summary>
			<div class="menupop" id="nav-mobile-menu">
				{
					links.map((link) => (
						<a class="mlink" href={link.href}>
							<span data-i18n={`nav.${link.key}`}>{link.label}</span>
						</a>
					))
				}
				<div class="menurow">
					<ThemeToggle id="theme-toggle-mobile" class="mtheme" size={18}>
						<span class="theme-label-light" data-i18n="nav.lightTheme">Light theme</span>
						<span class="theme-label-dark" data-i18n="nav.nightTheme">Night theme</span>
					</ThemeToggle>
					<div class="mlang mono" role="group" aria-label="Language">
						{
							languages.map((lang) => (
								<a href="#home" lang={lang.code} class="lang-option-mobile" data-lang={lang.code}>
									{lang.code.toUpperCase()}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</details>
	</nav>
</header>

<style>
	.theme-label-light {
		display: none;
	}
	:root[data-theme='dark'] .theme-label-light {
		display: inline;
	}
	:root[data-theme='dark'] .theme-label-dark {
		display: none;
	}
</style>

<script>
	import { translations, type Lang } from '../i18n/translations';

	const html = document.documentElement;

	const isLang = (value: string | null): value is Lang => value === 'en' || value === 'hu' || value === 'de';

	const siteName = 'Pukánszky Péter';

	const getPath = (obj: unknown, path: string): unknown =>
		path.split('.').reduce<unknown>((acc, key) => (acc && typeof acc === 'object' ? (acc as Record<string, unknown>)[key] : undefined), obj);

	const applyTranslations = (lang: Lang) => {
		const t = translations[lang] ?? translations.en;

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const key = el.dataset.i18n;
			if (!key) return;
			const value = getPath(t, key);
			if (typeof value === 'string') el.textContent = value;
		});

		document.querySelectorAll<HTMLElement>('.project-card').forEach((card, i) => {
			const project = t.projects.items?.[i];
			if (!project) return;
			card.dataset.name = project.name;
			card.dataset.year = project.year;
			card.dataset.desc = project.desc;
			card.dataset.overview = project.overview;
			card.dataset.role = project.role;
			card.dataset.highlights = JSON.stringify(project.highlights);
			card.dataset.tags = JSON.stringify(project.tags);
		});

		document.querySelector('meta[name="description"]')?.setAttribute('content', t.meta.description);

		const cvLink = document.getElementById('cv-download-link') as HTMLAnchorElement | null;
		if (cvLink) {
			cvLink.href = `/pukanszky-peter-cv-${lang}.pdf`;
			cvLink.download = `Pukanszky_Peter_CV_${lang.toUpperCase()}.pdf`;
		}

		html.lang = lang;
		document.title = `${siteName} — ${t.hero.tagline}`;
	};

	const langCurrent = document.getElementById('lang-current');
	const langMenuDetails = document.querySelector<HTMLDetailsElement>('.langmenu');
	const langOptions = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lang-option'));
	const langOptionsMobile = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lang-option-mobile'));

	const setActiveLang = (code: string) => {
		if (langCurrent) langCurrent.textContent = code.toUpperCase();
		langCurrent?.setAttribute('aria-label', `Change language (${code.toUpperCase()})`);

		langOptions.forEach((option) => {
			const isActive = option.dataset.lang === code;
			if (isActive) {
				option.setAttribute('aria-current', 'true');
				option.style.color = 'var(--atext)';
			} else {
				option.removeAttribute('aria-current');
				option.style.color = 'var(--ink2)';
			}
			const check = option.querySelector<SVGElement>('.lang-check');
			if (check) check.style.visibility = isActive ? 'visible' : 'hidden';
		});

		langOptionsMobile.forEach((option) => {
			const isActive = option.dataset.lang === code;
			if (isActive) option.setAttribute('aria-current', 'true');
			else option.removeAttribute('aria-current');
		});
	};

	[...langOptions, ...langOptionsMobile].forEach((option) => {
		option.addEventListener('click', (event) => {
			event.preventDefault();
			const code = option.dataset.lang ?? 'en';
			setActiveLang(code);
			try {
				localStorage.setItem('lang', code);
			} catch {
				/* localStorage unavailable */
			}
			if (isLang(code)) applyTranslations(code);
			langMenuDetails?.removeAttribute('open');
			document.querySelector<HTMLDetailsElement>('.menu')?.removeAttribute('open');
		});
	});

	document.addEventListener('click', (event) => {
		if (langMenuDetails?.open && !langMenuDetails.contains(event.target as Node)) {
			langMenuDetails.removeAttribute('open');
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			langMenuDetails?.removeAttribute('open');
			document.querySelector<HTMLDetailsElement>('.menu')?.removeAttribute('open');
		}
	});

	const mobileMenuDetails = document.querySelector<HTMLDetailsElement>('.menu');
	mobileMenuDetails?.addEventListener('toggle', () => {
		mobileMenuDetails.querySelector('summary')?.setAttribute('aria-expanded', String(mobileMenuDetails.open));
	});
	document.querySelectorAll('.menupop a').forEach((link) => {
		link.addEventListener('click', () => mobileMenuDetails?.removeAttribute('open'));
	});

	const storedLang = (() => {
		try {
			return localStorage.getItem('lang');
		} catch {
			return null;
		}
	})();
	const initialLang: Lang = isLang(storedLang) ? storedLang : 'en';
	setActiveLang(initialLang);
	applyTranslations(initialLang);

	const header = document.querySelector('header');
	const navLinks = header ? Array.from(header.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) : [];

	const syncNavHeight = () => {
		if (!header) return;
		html.style.setProperty('--nav-h', `${header.getBoundingClientRect().height}px`);
	};
	syncNavHeight();
	window.addEventListener('resize', syncNavHeight);
	document.fonts?.ready.then(syncNavHeight).catch(() => {});
	const sections = Array.from(document.querySelectorAll('main section[id]'));
	const intersecting = new Map<string, boolean>();

	const setActiveLink = (id: string) => {
		let activeLabel: string | null = null;

		navLinks.forEach((link) => {
			const isActive = link.getAttribute('href') === `#${id}`;
			link.classList.toggle('active', isActive);
			if (isActive && link.classList.contains('navlink')) activeLabel = link.textContent?.trim() ?? null;
		});

		if (activeLabel) {
			document.title = `${siteName} — ${activeLabel}`;
		}
	};

	let suppressSpy = false;
	let suppressTimeout: ReturnType<typeof setTimeout>;

	navLinks.forEach((link) => {
		link.addEventListener('click', () => {
			const id = link.getAttribute('href')?.slice(1);
			if (!id) return;

			suppressSpy = true;
			setActiveLink(id);
			history.replaceState(null, '', `${location.pathname}#${id}`);

			clearTimeout(suppressTimeout);
			suppressTimeout = setTimeout(() => {
				suppressSpy = false;
			}, 1000);
		});
	});

	const updateActive = () => {
		if (suppressSpy) return;

		const intersectingSections = sections.filter((section) => intersecting.get(section.id));
		const activeSection = intersectingSections[intersectingSections.length - 1];
		if (!activeSection) return;

		setActiveLink(activeSection.id);
		history.replaceState(null, '', `${location.pathname}#${activeSection.id}`);
	};

	if (!location.hash) {
		history.replaceState(null, '', `${location.pathname}#home`);
	}

	if (sections.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					intersecting.set(entry.target.id, entry.isIntersecting);
				});
				updateActive();
			},
			{ rootMargin: '-65px 0px -85% 0px', threshold: 0 },
		);

		sections.forEach((section) => observer.observe(section));

		const lastSection = sections[sections.length - 1];
		const isAtBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

		window.addEventListener(
			'scroll',
			() => {
				if (suppressSpy) return;
				if (isAtBottom()) {
					setActiveLink(lastSection.id);
					history.replaceState(null, '', `${location.pathname}#${lastSection.id}`);
				}
			},
			{ passive: true },
		);
	}
</script>
