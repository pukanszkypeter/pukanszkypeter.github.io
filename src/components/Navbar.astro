---
const links = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#experience", label: "Experience" },
  { href: "#education", label: "Education" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 h-16 border-b border-border bg-bg/90 backdrop-blur"
>
  <nav
    class="mx-auto flex h-full max-w-5xl items-center justify-between px-4 sm:px-6"
  >
    <a href="/" class="font-semibold text-ink">Pukánszky Péter</a>

    <ul class="hidden gap-6 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="group relative pb-1 text-sm text-muted transition-colors hover:text-accent"
            >
              <span data-i18n={`nav.${link.href.slice(1)}`}>{link.label}</span>
              <span class="absolute inset-x-0 -bottom-0.5 h-0.5 max-w-0 bg-accent transition-all duration-200 group-hover:max-w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="relative flex h-9 w-9 items-center justify-center text-ink transition-colors hover:text-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="absolute inset-0 m-auto h-5 w-5 rotate-90 scale-0 opacity-0 transition-all duration-500 ease-out dark:rotate-0 dark:scale-100 dark:opacity-100"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364 6.364-1.06-1.06M6.697 6.697l-1.06-1.06m12.727 0-1.06 1.06M6.697 17.303l-1.06 1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"
          ></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="absolute inset-0 m-auto h-5 w-5 rotate-0 scale-100 opacity-100 transition-all duration-500 ease-out dark:-rotate-90 dark:scale-0 dark:opacity-0"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          ></path>
        </svg>
      </button>

      <div class="relative">
        <button
          id="lang-toggle"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          class="flex h-9 items-center gap-1.5 rounded px-2 text-sm text-ink transition-colors hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 12h18M12 3c2.5 2.5 3.75 5.5 3.75 9s-1.25 6.5-3.75 9c-2.5-2.5-3.75-5.5-3.75-9S9.5 5.5 12 3Z"
            ></path>
          </svg>
          <span id="lang-current">EN</span>
        </button>

        <ul
          id="lang-menu"
          class="hidden absolute right-0 top-full z-50 mt-2 w-32 rounded-md border border-border bg-bg py-1 shadow-md"
        >
          {
            [
              { code: "en", label: "English" },
              { code: "hu", label: "Magyar" },
              { code: "de", label: "Deutsch" },
            ].map((lang) => (
              <li>
                <button
                  type="button"
                  data-lang={lang.code}
                  class="lang-option flex w-full items-center justify-between px-3 py-2 text-left text-sm text-muted transition-colors hover:bg-surface hover:text-accent"
                >
                  {lang.label}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="lang-check hidden h-4 w-4 text-accent"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        class="flex h-9 w-9 items-center justify-center text-ink md:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-6 w-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
        </svg>
      </button>
    </div>
  </nav>

  <ul
    id="nav-mobile-menu"
    class="hidden flex-col gap-1 border-b border-border bg-bg px-4 pb-4 md:hidden"
  >
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded px-2 py-2 text-sm text-muted transition-colors hover:bg-surface hover:text-accent"
          >
            <span data-i18n={`nav.${link.href.slice(1)}`}>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  import { translations, type Lang } from "../i18n/translations";

  const themeToggle = document.getElementById("theme-toggle");

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  const isLang = (value: string | null): value is Lang =>
    value === "en" || value === "hu" || value === "de";

  const siteName = "Pukánszky Péter";

  const getPath = (obj: unknown, path: string): unknown =>
    path
      .split(".")
      .reduce<unknown>(
        (acc, key) =>
          acc && typeof acc === "object" ? (acc as Record<string, unknown>)[key] : undefined,
        obj,
      );

  const applyTranslations = (lang: Lang) => {
    const t = translations[lang] ?? translations.en;

    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.dataset.i18n;
      if (!key) return;
      const value = getPath(t, key);
      if (typeof value === "string") el.textContent = value;
    });

    document.querySelectorAll<HTMLButtonElement>(".project-trigger").forEach((trigger) => {
      trigger.dataset.title = t.projects.item.title;
      trigger.dataset.description = t.projects.item.description;
      trigger.dataset.details = t.projects.item.details;
      trigger.dataset.tags = JSON.stringify(t.projects.item.tags);
    });

    document
      .querySelector('meta[name="description"]')
      ?.setAttribute("content", t.meta.description);

    const cvLink = document.getElementById("cv-download-link") as HTMLAnchorElement | null;
    if (cvLink) {
      cvLink.href = `/pukanszky-peter-cv-${lang}.pdf`;
      cvLink.download = `Pukanszky_Peter_CV_${lang.toUpperCase()}.pdf`;
    }

    document.documentElement.lang = lang;
    document.title = `${siteName} — ${t.hero.tagline}`;
  };

  const langToggle = document.getElementById("lang-toggle");
  const langMenu = document.getElementById("lang-menu");
  const langCurrent = document.getElementById("lang-current");
  const langOptions = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".lang-option"),
  );

  const closeLangMenu = () => {
    langMenu?.classList.add("hidden");
    langToggle?.setAttribute("aria-expanded", "false");
  };

  const setActiveLang = (code: string) => {
    if (langCurrent) langCurrent.textContent = code.toUpperCase();
    langToggle?.setAttribute("aria-label", `Change language (${code.toUpperCase()})`);

    langOptions.forEach((option) => {
      const isActive = option.dataset.lang === code;
      option.classList.toggle("text-accent", isActive);
      option.classList.toggle("text-muted", !isActive);
      option.querySelector(".lang-check")?.classList.toggle("hidden", !isActive);
    });
  };

  langToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = !langMenu?.classList.contains("hidden");
    langMenu?.classList.toggle("hidden");
    langToggle.setAttribute("aria-expanded", String(!isOpen));
  });

  langOptions.forEach((option) => {
    option.addEventListener("click", () => {
      const code = option.dataset.lang ?? "en";
      setActiveLang(code);
      localStorage.setItem("lang", code);
      if (isLang(code)) applyTranslations(code);
      closeLangMenu();
    });
  });

  document.addEventListener("click", (event) => {
    if (
      langMenu &&
      !langMenu.classList.contains("hidden") &&
      !langMenu.contains(event.target as Node) &&
      event.target !== langToggle
    ) {
      closeLangMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLangMenu();
  });

  const storedLang = localStorage.getItem("lang");
  const initialLang: Lang = isLang(storedLang) ? storedLang : "en";
  setActiveLang(initialLang);
  applyTranslations(initialLang);

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }

  const header = document.querySelector("header");
  const navLinks = header
    ? Array.from(header.querySelectorAll('a[href^="#"]'))
    : [];
  const sections = Array.from(document.querySelectorAll("main section[id]"));
  const intersecting = new Map();

  const setActiveLink = (id: string) => {
    let activeLabel: string | null = null;

    navLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === `#${id}`;
      link.classList.toggle("text-accent", isActive);
      link.classList.toggle("text-muted", !isActive);
      if (isActive) activeLabel = link.textContent?.trim() ?? null;

      const underline = link.querySelector("span");
      if (underline) {
        underline.classList.toggle("max-w-full", isActive);
        underline.classList.toggle("max-w-0", !isActive);
      }
    });

    if (activeLabel) {
      document.title = `Pukánszky Péter — ${activeLabel}`;
    }
  };

  let suppressSpy = false;
  let suppressTimeout: ReturnType<typeof setTimeout>;

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const id = link.getAttribute("href")?.slice(1);
      if (!id) return;

      suppressSpy = true;
      setActiveLink(id);
      history.replaceState(null, "", `${location.pathname}#${id}`);

      clearTimeout(suppressTimeout);
      suppressTimeout = setTimeout(() => {
        suppressSpy = false;
      }, 1000);
    });
  });

  const updateActive = () => {
    if (suppressSpy) return;

    const intersectingSections = sections.filter((section) =>
      intersecting.get(section.id),
    );
    const activeSection = intersectingSections[intersectingSections.length - 1];
    if (!activeSection) return;

    setActiveLink(activeSection.id);

    history.replaceState(
      null,
      "",
      `${location.pathname}#${activeSection.id}`,
    );
  };

  if (!location.hash && sections.some((section) => section.id === "home")) {
    history.replaceState(null, "", `${location.pathname}#home`);
  }

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          intersecting.set(entry.target.id, entry.isIntersecting);
        });
        updateActive();
      },
      { rootMargin: "-65px 0px -85% 0px", threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));

    const lastSection = sections[sections.length - 1];
    const isAtBottom = () =>
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;

    window.addEventListener(
      "scroll",
      () => {
        if (suppressSpy) return;
        if (isAtBottom()) {
          setActiveLink(lastSection.id);
          history.replaceState(
            null,
            "",
            `${location.pathname}#${lastSection.id}`,
          );
        }
      },
      { passive: true },
    );
  }
</script>
