---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangMenu from '../components/LangMenu.astro';

const jump = [
	{ href: '/#about', label: 'About', key: 'about' },
	{ href: '/#projects', label: 'Projects', key: 'projects' },
	{ href: '/#contact', label: 'Contact', key: 'contact' },
];
---

<Layout title="404 — Pukánszky Péter" noindex>
	<div class="themed nf-root">
		<div aria-hidden="true">
			<div class="blob" style="top:-180px;left:-12%;width:760px;height:760px;background:radial-gradient(circle at 50% 50%,rgba(255,138,61,0.95),rgba(255,138,61,0) 68%)"></div>
			<div class="blob b2" style="top:60px;right:-14%;width:700px;height:700px;background:radial-gradient(circle at 50% 50%,rgba(255,176,103,0.95),rgba(255,176,103,0) 68%)"></div>
			<div class="blob b3" style="bottom:-220px;left:28%;width:720px;height:720px;background:radial-gradient(circle at 50% 50%,rgba(255,106,31,0.42),rgba(255,106,31,0) 68%)"></div>
			<div style="position:absolute;top:0;left:0;right:0;height:900px;pointer-events:none;background-image:radial-gradient(var(--dot) 1px,transparent 1.6px);background-size:28px 28px;-webkit-mask-image:linear-gradient(to bottom,#000 0%,transparent 100%);mask-image:linear-gradient(to bottom,#000 0%,transparent 100%)"></div>
		</div>

		<div class="nf-inner">
			<header style="position:sticky;top:0;z-index:50;padding:0 16px;display:flow-root">
				<nav aria-label="Main" class="glass-strong" style="max-width:1160px;margin:14px auto 0;border-radius:999px;padding:6px 8px;display:flex;align-items:center;justify-content:space-between;gap:12px">
					<a href="/" class="navname display" style="flex:0 0 auto" aria-label="Pukánszky Péter — home">Pukánszky Péter<span style="color:var(--accent)">.</span></a>
					<div style="flex:0 0 auto;display:flex;align-items:center;gap:8px">
						<ThemeToggle ariaLabel="Toggle theme" />
						<LangMenu />
					</div>
				</nav>
			</header>

			<main class="nf-main">
				<span class="mono" style="font-size:13px;font-weight:500;color:var(--atext);letter-spacing:0.08em;text-transform:uppercase" data-i18n="notFound.label">Error 404</span>
				<div class="nf-num rise" aria-hidden="true"><span class="grad">4</span><span class="nf-zero spin"></span><span class="grad">4</span></div>
				<h1 class="display" style="font-size:clamp(32px,4.6vw,56px);line-height:1.05;font-weight:700;max-width:760px">
					<span data-i18n="notFound.titlePlain">This page wandered</span>{' '}<span class="grad" data-i18n="notFound.titleAccent">off.</span>
				</h1>
				<p style="font-size:18px;line-height:1.6;color:var(--ink2);max-width:480px" data-i18n="notFound.body">
					The link may be broken or the page may have moved. Let's get you back on track.
				</p>
				<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:6px">
					<a class="btn btn-primary" href="/">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
						<span data-i18n="notFound.backHome">Back to home</span>
					</a>
					<a class="btn btn-glass glass" href="/#projects"><span data-i18n="hero.viewProjects">View Projects</span></a>
				</div>

				<div style="display:flex;flex-direction:column;align-items:center;gap:14px;width:100%;margin-top:30px">
					<span class="mono" style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--atext)" data-i18n="notFound.jumpTo">Or jump to</span>
					<div class="nf-links">
						{
							jump.map((item) => (
								<a class="glass linkrow" href={item.href} style="display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:0 20px;border-radius:18px;font-weight:600;font-size:15px">
									<span data-i18n={`nav.${item.key}`}>{item.label}</span>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--atext)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
								</a>
							))
						}
					</div>
				</div>
			</main>

			<footer style="max-width:1160px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 24px 40px;text-align:center">
				<span style="font-size:13px;color:var(--muted)">© Pukánszky Péter</span>
			</footer>
		</div>
	</div>
</Layout>

<style>
	.nf-root {
		position: relative;
		overflow: clip;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
	}
	.nf-inner {
		position: relative;
		z-index: 1;
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
	}
	.nf-main {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 22px;
		padding: 48px 24px 72px;
	}
	.nf-num {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.02em;
		font-family: 'Bricolage Grotesque', 'Geist', system-ui, sans-serif;
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1;
		font-size: clamp(110px, min(24vw, 26svh), 280px);
	}
	.nf-zero {
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		border-radius: 50%;
		background: conic-gradient(from 0deg, #ff8a3d, #c2410c, #ffd2a8, #ff8a3d);
		-webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 0.13em), #000 calc(100% - 0.13em + 1px));
		mask: radial-gradient(farthest-side, transparent calc(100% - 0.13em), #000 calc(100% - 0.13em + 1px));
	}
	.nf-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
		gap: 12px;
		width: 100%;
		max-width: 720px;
	}
	/* The popover overlaps page text on narrow screens, where the nested backdrop blur does not apply */
	.nf-root :global(.langpop) {
		background: color-mix(in srgb, var(--bg) 93%, transparent);
	}
	@media (max-width: 760px) {
		.blob {
			filter: blur(6px);
		}
	}
</style>

<script>
	import { translations, type Lang } from '../i18n/translations';

	const isLang = (value: string | null): value is Lang => value === 'en' || value === 'hu' || value === 'de';

	const storedLang = (() => {
		try {
			return localStorage.getItem('lang');
		} catch {
			return null;
		}
	})();
	const langMenu = document.querySelector<HTMLDetailsElement>('.langmenu');
	const langCurrent = document.getElementById('lang-current');
	const langOptions = Array.from(document.querySelectorAll<HTMLAnchorElement>('.lang-option'));

	const applyLang = (lang: Lang) => {
		const t = translations[lang];

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const value = el.dataset.i18n
				?.split('.')
				.reduce<unknown>((acc, key) => (acc && typeof acc === 'object' ? (acc as Record<string, unknown>)[key] : undefined), t);
			if (typeof value === 'string') el.textContent = value;
		});
		document.documentElement.lang = lang;

		if (langCurrent) langCurrent.textContent = lang.toUpperCase();
		langCurrent?.setAttribute('aria-label', `Change language (${lang.toUpperCase()})`);
		langOptions.forEach((option) => {
			const isActive = option.dataset.lang === lang;
			if (isActive) option.setAttribute('aria-current', 'true');
			else option.removeAttribute('aria-current');
			option.style.color = isActive ? 'var(--atext)' : 'var(--ink2)';
			const check = option.querySelector<SVGElement>('.lang-check');
			if (check) check.style.visibility = isActive ? 'visible' : 'hidden';
		});
	};

	langOptions.forEach((option) => {
		option.addEventListener('click', (event) => {
			event.preventDefault();
			const code = option.dataset.lang ?? null;
			if (!isLang(code)) return;
			try {
				localStorage.setItem('lang', code);
			} catch {
				/* localStorage unavailable */
			}
			applyLang(code);
			langMenu?.removeAttribute('open');
		});
	});

	document.addEventListener('click', (event) => {
		if (langMenu?.open && !langMenu.contains(event.target as Node)) langMenu.removeAttribute('open');
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') langMenu?.removeAttribute('open');
	});

	applyLang(isLang(storedLang) ? storedLang : 'en');
</script>
