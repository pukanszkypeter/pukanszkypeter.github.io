---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Navbar />
	<main class="flex min-h-[calc(100vh-4rem)] items-center bg-bg px-4 pt-16">
		<div class="mx-auto max-w-xl text-center">
			<p class="text-sm font-medium text-accent">404</p>
			<h1 class="mt-3 text-3xl font-bold text-ink sm:text-4xl" data-i18n="notFound.title">Page not found</h1>
			<p class="mx-auto mt-4 max-w-md text-muted" data-i18n="notFound.body">
				The page you're looking for doesn't exist. It might have been moved, or the link might be
				incorrect.
			</p>

			<div class="mt-8">
				<a
					href="/"
					class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
					data-i18n="notFound.backHome"
				>
					Back to Home
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
